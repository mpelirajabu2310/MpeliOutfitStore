# Logs
logs/
logs/ratelimit/
logs/.maintenance
*.log

# Development tools
_dev/

# Environment
.env

# Local database configuration (never commit - production has its own)
/config/database.php

# Database (production only — use database/clothing_shop_management.sql)
database/*.sql

# Backups (keep deployment guard files, ignore generated backup artifacts)
backups/mpelioutfitstore_*
backups/.backup_state.json
backups/.backup.lock

# Uploaded product images (keep guard files, ignore actual images)
uploads/products/*
!uploads/products/index.html
uploads/*.webp
uploads/*.jpg
uploads/*.jpeg
uploads/*.png
uploads/*.gif

# OS files
.DS_Store
Thumbs.db
